# TikDownloader Backend Environment Variables

# Server Port
PORT=5001

# Backend URL (for frontend to call)
BACKEND_URL=http://localhost:5001

# Production mode
NODE_ENV=development

# External API timeouts
TIKWM_API_TIMEOUT=15000
VIDEO_DOWNLOAD_TIMEOUT=30000

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=20
MAX_CONCURRENT_EXTERNAL_REQUESTS=4

# Request size limit
REQUEST_SIZE_LIMIT=2mb

# CORS
# Use a comma-separated list of allowed frontend origins without a trailing slash.
CORS_ORIGIN=https://www.wadajirict.com/
